# Shopigent Returns — Environment Variables

# Shopify App credentials (from Partners Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,read_products,write_orders,read_orders,read_customers,write_customers,write_fulfillments,read_fulfillments,read_inventory,write_inventory,write_draft_orders,read_draft_orders,write_price_rules,read_price_rules,write_discounts,read_discounts

# App URL (Railway domain)
APP_URL=https://returns-app-production.up.railway.app

# Database (Railway Postgres)
DATABASE_URL=postgresql://postgres:***@postgres.railway.internal:5432/railway

# Confirmation token secret (generate a random 64-char string)
CONFIRMATION_TOKEN_SECRET=

# Node environment
NODE_ENV=production