generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReturnStatus {
  PENDING
  APPROVED
  DENIED
  EXCHANGE
  SHIPPED
  REFUNDED
  CLOSED
}

model Session {
  id                  String    @id @default(cuid())
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String?
  refreshToken        String?
  refreshTokenExpires DateTime?
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?
  emailVerified       Boolean?
  onlineAccessInfo    Json?

  @@unique([shop, isOnline])
  @@index([shop])
}

model ReturnRequest {
  id              String       @id @default(uuid())
  shop            String
  orderId         String
  orderName       String?
  customerEmail   String?
  customerName    String?
  items           Json         @default("[]")
  reason          String?
  status          ReturnStatus @default(PENDING)
  aiDecision      Json?
  aiConfidence    Float?
  decidedBy       String?
  decidedAt       DateTime?
  labels          Json         @default("[]")
  refundAmount    Decimal?     @db.Decimal(10, 2)
  refundId        String?
  shopifyReturnId String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  fraudSignals FraudSignal[]
  decisionLogs DecisionLog[]

  @@index([shop])
  @@index([shop, status])
  @@index([shop, createdAt])
}

model Policy {
  id          String   @id @default(uuid())
  shop        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  conditions  Json     @default("[]")
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop])
  @@index([shop, isActive])
}

model OtpCode {
  id        String   @id @default(uuid())
  shop      String
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([shop, email])
  @@index([shop, email, code])
}

model FraudSignal {
  id        String   @id @default(uuid())
  returnId  String
  signal    String
  score     Float
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  return ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

model DecisionLog {
  id        String   @id @default(uuid())
  returnId  String
  actor     String
  action    String
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  return ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([returnId, createdAt])
}

model Shop {
  id            String    @id
  shop          String    @unique
  name          String?
  email         String?
  domain        String?
  planName      String?
  planStatus    String?
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  mcpApiKeyHash String?   @unique
  config        Json      @default("{}")

  @@index([shop])
}
